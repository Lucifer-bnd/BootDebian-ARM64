#!/system/bin/sh

ROOT="/data/local/debian"

if [ "$(id -u)" != "0" ]; then
    echo "[BootDebian] Please run as root: su"
    exit 1
fi

if [ ! -x "$ROOT/bin/bash" ]; then
    echo "[BootDebian] Debian is not installed at $ROOT"
    exit 1
fi

if ! command -v chroot >/dev/null 2>&1; then
    echo "[BootDebian] chroot command not found on this device."
    exit 1
fi

mkdir -p "$ROOT/dev/pts" "$ROOT/proc" "$ROOT/sys" "$ROOT/tmp"
chmod 1777 "$ROOT/tmp"

MOUNTED_PROC=0
MOUNTED_SYS=0
MOUNTED_DEV=0

cleanup() {
    [ "$MOUNTED_DEV" -eq 1 ] && umount -l "$ROOT/dev" 2>/dev/null
    [ "$MOUNTED_SYS" -eq 1 ] && umount -l "$ROOT/sys" 2>/dev/null
    [ "$MOUNTED_PROC" -eq 1 ] && umount -l "$ROOT/proc" 2>/dev/null
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "[BootDebian] Mounting Debian filesystems..."

if ! mount -t proc proc "$ROOT/proc"; then
    echo "[BootDebian] Failed to mount proc."
    exit 1
fi
MOUNTED_PROC=1

if ! mount --bind /sys "$ROOT/sys"; then
    echo "[BootDebian] Failed to bind-mount sys."
    exit 1
fi
MOUNTED_SYS=1

if ! mount --bind /dev "$ROOT/dev"; then
    echo "[BootDebian] Failed to bind-mount dev."
    exit 1
fi
MOUNTED_DEV=1


if [ -r /etc/resolv.conf ]; then
    cp /etc/resolv.conf "$ROOT/etc/resolv.conf" 2>/dev/null || true
fi

echo "[BootDebian] Starting Debian 13 (Trixie)."
echo "[BootDebian] Type 'exit' to leave Debian."
chroot "$ROOT" /bin/bash -l
STATUS=$?

echo "[BootDebian] Debian session closed."
exit "$STATUS"
